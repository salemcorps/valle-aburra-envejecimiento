{
  "name": "Windows 96 - Valle de Aburra",

  "dataColors": [
    "#000080",
    "#D6195A",
    "#008080",
    "#E6B800",
    "#1EAA3C",
    "#800080",
    "#808080",
    "#1084D0"
  ],

  "background": "#FFFFFF",
  "foreground": "#000000",
  "tableAccent": "#000080",

  "good": "#1EAA3C",
  "neutral": "#E6B800",
  "bad": "#D6195A",

  "maximum": "#000080",
  "center": "#1084D0",
  "minimum": "#C0C0C0",

  "firstLevelElements": "#000000",
  "secondLevelElements": "#404040",
  "thirdLevelElements": "#808080",
  "fourthLevelElements": "#C0C0C0",
  "secondaryBackground": "#C0C0C0",

  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Courier New",
      "color": "#000080"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Tahoma",
      "color": "#000000"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Tahoma",
      "color": "#000080"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Tahoma",
      "color": "#000000"
    }
  },

  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#29A096" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#1F7A72" } }
          }
        ]
      }
    },

    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#000000" } },
            "radius": 0
          }
        ],
        "title": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "background": { "solid": { "color": "#000080" } },
            "fontFamily": "Tahoma",
            "fontSize": 11,
            "bold": true,
            "alignment": "left"
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#000000" } },
            "position": "Outer",
            "preset": "BottomRight",
            "shadowSpread": 0,
            "shadowBlur": 0,
            "angle": 45,
            "shadowDistance": 4,
            "transparency": 0
          }
        ]
      }
    },

    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#000080" } },
            "fontSize": 28,
            "fontFamily": "Courier New",
            "bold": true
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#000000" } },
            "fontSize": 11,
            "fontFamily": "Tahoma"
          }
        ]
      }
    },

    "lineChart": {
      "*": {
        "categoryAxis": [
          {
            "gridlineShow": false,
            "labelColor": { "solid": { "color": "#000000" } },
            "fontSize": 10,
            "fontFamily": "Tahoma"
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": true,
            "gridlineColor": { "solid": { "color": "#C0C0C0" } },
            "gridlineStyle": "dotted",
            "labelColor": { "solid": { "color": "#000000" } },
            "fontSize": 10,
            "fontFamily": "Tahoma"
          }
        ],
        "legend": [
          {
            "labelColor": { "solid": { "color": "#000000" } },
            "fontSize": 10,
            "fontFamily": "Tahoma"
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 3
          }
        ]
      }
    },

    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": { "solid": { "color": "#000080" } },
            "fontFamily": "Tahoma",
            "fontSize": 11,
            "bold": true
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#000000" } },
            "fontFamily": "Tahoma",
            "fontSize": 11
          }
        ]
      }
    }
  }
}
